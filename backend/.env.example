# ===== 服务 =====
NODE_ENV=development
PORT=3000
APP_NAME=teachstudy

# ===== 数据库（开发默认 better-sqlite3，可换 mysql/postgres）=====
DB_TYPE=better-sqlite3
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=./data/teachstudy.db

# ===== 字段级加密（手机号/监护人手机在库落地加密，务必配置 ≥32 字节随机值）=====
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ENCRYPTION_KEY=

# ===== JWT 认证 =====
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ===== AI 服务（免费/低价大模型接入）=====
# provider: mock=本地占位(零联网,开箱即用) | http=接入 OpenAI 兼容大模型(推荐)
AI_PROVIDER=mock
# OpenAI 兼容接口地址（代码会自动拼接 /chat/completions，也可直接填完整地址）
#   智谱 GLM : https://open.bigmodel.cn/api/paas/v4
#   硅基流动 : https://api.siliconflow.cn/v1
#   阿里通义 : https://dashscope.aliyuncs.com/compatible-mode/v1
#   DeepSeek : https://api.deepseek.com/v1
#   Moonshot : https://api.moonshot.cn/v1
AI_API_BASE=
AI_API_KEY=
# 模型名（按所选厂商填写）：
#   智谱: glm-4-flash(免费) | 硅基流动: Qwen/Qwen2.5-7B-Instruct(免费) | 通义: qwen-turbo | DeepSeek: deepseek-chat
AI_MODEL=glm-4-flash

# ===== 资源存储 =====
STORAGE_DIR=./uploads

# ===== 缓存 / 限流 =====
CACHE_TTL_SECONDS=300
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120